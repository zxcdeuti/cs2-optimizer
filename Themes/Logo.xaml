<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- App mark on a 256×256 canvas: lime tile, viewfinder brackets, crosshair with an open centre.
         AppLogoSmall drops the brackets and thickens the cross so it survives 16–32 px.
         tools/make-icon.ps1 renders both into Assets/app.ico. -->
    <LinearGradientBrush x:Key="LogoTile" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#DDFF5E" Offset="0"/>
        <GradientStop Color="#C8F52A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LogoInk" Color="#0C0C0D"/>

    <DrawingImage x:Key="AppLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource LogoTile}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,256,256" RadiusX="54" RadiusY="54"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M48,94 V48 H94 M162,48 H208 V94 M208,162 V208 H162 M94,208 H48 V162">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LogoInk}" Thickness="14" StartLineCap="Square" EndLineCap="Square" LineJoin="Miter"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource LogoInk}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="144,120,32,16"/>
                            <RectangleGeometry Rect="80,120,32,16"/>
                            <RectangleGeometry Rect="120,80,16,32"/>
                            <RectangleGeometry Rect="120,144,16,32"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="AppLogoSmall">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource LogoTile}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,256,256" RadiusX="54" RadiusY="54"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource LogoInk}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="150,110,62,36"/>
                            <RectangleGeometry Rect="44,110,62,36"/>
                            <RectangleGeometry Rect="110,44,36,62"/>
                            <RectangleGeometry Rect="110,150,36,62"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
