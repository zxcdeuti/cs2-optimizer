<UserControl x:Class="CS2Optimizer.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,6,48,48">
            <TextBlock Text="10 / ЗАМЕРЫ FPS" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Сессии в игре" Style="{StaticResource H1}"/>
            <TextBlock Text="Каждый запуск CS2 записывается сам, пока работает ватермарка с правами администратора. Так видно, дала ли настройка прирост."
                       Style="{StaticResource Lead}"/>
            <Rectangle Style="{StaticResource PageRule}"/>

            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,24">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Открыть журнал" Click="OpenLog_Click" VerticalAlignment="Center"/>
                    <Rectangle x:Name="StateDot" Width="8" Height="8" Fill="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                    <StackPanel Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StateTitle" Style="{StaticResource Label}" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                        <TextBlock x:Name="StateDetail" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" FontSize="14" LineHeight="21" MaxWidth="640" HorizontalAlignment="Left"
                       Text="Пока замеров нет. Сыграй хотя бы минуту с включённой ватермаркой: результат появится здесь и будет обновляться каждую минуту игры."/>

            <StackPanel x:Name="Body" Visibility="Collapsed">
                <TextBlock x:Name="LastTitle" Style="{StaticResource Label}" Margin="0,0,0,14"/>
                <WrapPanel>
                    <StackPanel Margin="0,0,56,12">
                        <TextBlock Text="СРЕДНИЙ FPS" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="AvgText" Style="{StaticResource Num}" FontSize="56" FontWeight="Light" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock x:Name="AvgDelta" Style="{StaticResource Label}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,56,12">
                        <TextBlock Text="1% LOW" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="LowText" Style="{StaticResource Num}" FontSize="56" FontWeight="Light"/>
                        <TextBlock x:Name="LowDelta" Style="{StaticResource Label}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,56,12">
                        <TextBlock Text="МАКС. CPU" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="CpuText" Style="{StaticResource Num}" FontSize="56" FontWeight="Light"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="МАКС. GPU" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="GpuText" Style="{StaticResource Num}" FontSize="56" FontWeight="Light"/>
                    </StackPanel>
                </WrapPanel>

                <DockPanel Margin="0,28,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Очистить историю" Click="Clear_Click"/>
                    <TextBlock Text="ИСТОРИЯ" Style="{StaticResource Label}"/>
                </DockPanel>
                <Rectangle Style="{StaticResource Hairline}"/>
                <ItemsControl x:Name="History">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Start, StringFormat={}{0:dd.MM.yyyy HH:mm}}" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Duration}" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Avg}" Style="{StaticResource Num}" FontSize="14"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Low}" Style="{StaticResource Num}" FontSize="14"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Temps}" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Preset}" FontSize="13" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                           Text="Считается время, пока CS2 на переднем плане, вместе с меню и разминкой. Сравнивай сессии с похожей нагрузкой: матч с матчем, а не с меню."/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
