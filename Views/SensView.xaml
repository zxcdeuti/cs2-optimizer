<UserControl x:Class="CS2Optimizer.Views.SensView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,6,48,48">
            <TextBlock Text="06 / СЕНСА И МЫШЬ" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Чувствительность" Style="{StaticResource H1}"/>
            <TextBlock Text="eDPI и сантиметры на 360°, перевод сенсы из других игр и настройки мыши в Windows."
                       Style="{StaticResource Lead}"/>
            <Rectangle Style="{StaticResource PageRule}"/>

            <!-- Calculator -->
            <TextBlock Text="A — КАЛЬКУЛЯТОР" Style="{StaticResource Label}" Margin="0,0,0,14"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DPI МЫШИ" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBox x:Name="DpiBox" Style="{StaticResource Field}" Text="800" TextChanged="Calc_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="СЕНСА В CS2" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBox x:Name="SensBox" Style="{StaticResource Field}" Text="1.1" TextChanged="Calc_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="EDPI" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="EdpiText" Text="—" Style="{StaticResource Num}" FontSize="46" FontWeight="Light" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="СМ НА 360°" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="Cm360Text" Text="—" Style="{StaticResource Num}" FontSize="46" FontWeight="Light" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- eDPI scale with the typical pro range -->
            <Grid Margin="0,26,0,0" x:Name="ScaleHost" Height="44" SizeChanged="Scale_SizeChanged">
                <Rectangle Height="2" Fill="{StaticResource LineStrongBrush}" VerticalAlignment="Top" Margin="0,9,0,0"/>
                <Canvas x:Name="ScaleCanvas"/>
            </Grid>
            <TextBlock x:Name="ScaleNote" Style="{StaticResource Muted}" Margin="0,4,0,0"/>

            <!-- Converter -->
            <TextBlock Text="B — ПЕРЕВОД ИЗ ДРУГОЙ ИГРЫ" Style="{StaticResource Label}" Margin="0,44,0,12"/>
            <WrapPanel x:Name="GameHost">
                <RadioButton Style="{StaticResource Chip}" GroupName="game" Tag="0.07" Content="Valorant" IsChecked="True" Checked="Convert_Changed"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="game" Tag="0.0066" Content="Overwatch 2" Checked="Convert_Changed"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="game" Tag="0.0066" Content="Call of Duty" Checked="Convert_Changed"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="game" Tag="0.022" Content="Apex Legends" Checked="Convert_Changed"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="game" Tag="0.022" Content="CS:GO" Checked="Convert_Changed"/>
            </WrapPanel>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="СЕНСА ТАМ" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBox x:Name="OtherBox" Style="{StaticResource Field}" Text="0.35" TextChanged="Convert_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="СЕНСА В CS2" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="ConvertedText" Text="—" Style="{StaticResource Num}" FontSize="46" FontWeight="Light"
                               Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button Style="{StaticResource SecondaryButton}" Click="CopySens_Click">
                        <TextBlock x:Name="CopySensText" Text="Копировать команду"/>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock Text="Перевод по углу поворота на одно движение мыши — то же расстояние на коврике даёт тот же поворот камеры."
                       Style="{StaticResource Muted}" Margin="0,10,0,0"/>

            <!-- Windows mouse -->
            <TextBlock Text="C — МЫШЬ В WINDOWS" Style="{StaticResource Label}" Margin="0,44,0,6"/>
            <Rectangle Style="{StaticResource Hairline}"/>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AccelStatus" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Margin="0,3,0,0"/>
                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                        <TextBlock Text="Акселерация («Повышенная точность указателя»)" FontSize="14.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AccelDetail" Style="{StaticResource Muted}" Margin="0,4,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Button x:Name="AccelBtn" Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="16,8" Content="Выключить"
                            Click="Accel_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SpeedStatus" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Margin="0,3,0,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Скорость указателя" FontSize="14.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SpeedDetail" Style="{StaticResource Muted}" Margin="0,4,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
