<UserControl x:Class="CS2Optimizer.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CS2Optimizer.Views"
             Loaded="OnLoaded" Unloaded="OnUnloaded" SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <Style x:Key="RowIcon" TargetType="Path">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Stroke" Value="{StaticResource MutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Chevron" TargetType="Path" BasedOn="{StaticResource RowIcon}">
            <Setter Property="Data" Value="{StaticResource IconChevron}"/>
            <Setter Property="Stroke" Value="{StaticResource DimBrush}"/>
            <Setter Property="Grid.Column" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <SolidColorBrush x:Key="RingBrush" Color="#F5B335" Opacity="0.2"/>
    </UserControl.Resources>

    <Grid>
        <!-- A radar on the planning table: the real map if the game is installed, the rings either way. -->
        <Viewbox x:Name="ArtBox" Width="660" Height="660" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-150,0" IsHitTestVisible="False">
        <Grid Width="660" Height="660">
            <Image x:Name="RadarArt" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.OpacityMask>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF000000" Offset="0.45"/>
                        <GradientStop Color="#00000000" Offset="0.98"/>
                    </RadialGradientBrush>
                </Image.OpacityMask>
            </Image>
            <Canvas Width="660" Height="660">
                <Ellipse Canvas.Left="240" Canvas.Top="240" Width="180" Height="180" Stroke="{StaticResource RingBrush}"/>
                <Ellipse Canvas.Left="150" Canvas.Top="150" Width="360" Height="360" Stroke="{StaticResource RingBrush}"/>
                <Ellipse Canvas.Left="60" Canvas.Top="60" Width="540" Height="540" Stroke="{StaticResource RingBrush}" StrokeDashArray="1 5"/>
                <Path Data="M330,0 V300 M330,360 V660 M0,330 H300 M360,330 H660" Stroke="{StaticResource RingBrush}"/>
                <Path x:Name="Sweep" Data="M330,330 L330,60 A270,270 0 0 1 536.8,156.4 Z" Opacity="0" RenderTransformOrigin="0,0">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="1,0.75" EndPoint="0,0.2">
                            <GradientStop Color="#70F5B335" Offset="0"/>
                            <GradientStop Color="#00F5B335" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SweepAngle" CenterX="330" CenterY="330"/>
                    </Path.RenderTransform>
                </Path>
            </Canvas>
        </Grid>
        </Viewbox>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="44,8,44,40" MaxWidth="1160" HorizontalAlignment="Stretch">
                <Grid>
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock x:Name="Headline" Text="ПРОВЕРЯЮ&#10;СИСТЕМУ" Style="{StaticResource Hero}"/>
                        <TextBlock x:Name="HeadSub" Style="{StaticResource Lead}" MaxWidth="420" Margin="0,12,0,0"/>
                        <Button x:Name="FixBtn" Style="{StaticResource PrimaryButton}" Content="Открыть проверки" Tag="system" Click="Open_Click"
                                HorizontalAlignment="Left" Margin="0,16,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <ui:Plate x:Name="MapLinkBox" Background="#E610151D" CutTopRight="7" Padding="11,4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="0,0,0,2" Visibility="Collapsed">
                        <Button x:Name="MapLink" Style="{StaticResource LinkButton}" Click="MapLink_Click"/>
                    </ui:Plate>
                </Grid>

                <Grid Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="270"/>
                    </Grid.ColumnDefinitions>

                    <!-- Where things stand, each row opens its section -->
                    <ui:Plate Style="{StaticResource Slab}" Padding="0" ClipContent="True">
                        <UniformGrid Columns="1" Margin="0,0,0,-1">
                            <Button Style="{StaticResource LinkRow}" Tag="system" Click="Open_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource RowIcon}" Data="{StaticResource IconSystem}"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <TextBlock Text="Windows" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="WinDetail" Text="Проверяю настройки…" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="WinState" Grid.Column="2" Style="{StaticResource Icon}" FontSize="15"/>
                                    <Path Style="{StaticResource Chevron}"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource LinkRow}" Tag="graphics" Click="Open_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource RowIcon}" Data="{StaticResource IconGraphics}"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <TextBlock Text="Графика" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="GfxDetail" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Path Style="{StaticResource Chevron}"/>
                                </Grid>
                            </Button>
                            <Grid>
                                <Button Style="{StaticResource LinkRow}" Tag="watermark" Click="Open_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Style="{StaticResource RowIcon}" Data="{StaticResource IconWatermark}"/>
                                        <StackPanel Grid.Column="1" Margin="0,0,120,0">
                                            <TextBlock Text="Ватермарка" Style="{StaticResource RowTitle}"/>
                                            <TextBlock x:Name="WmDetail" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Path Style="{StaticResource Chevron}"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="WmBtn" Style="{StaticResource SecondaryButton}" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,54,0" Click="Overlay_Click">
                                    <TextBlock x:Name="WmBtnText"/>
                                </Button>
                            </Grid>
                            <Button Style="{StaticResource LinkRow}" Tag="crosshair" Click="Open_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource RowIcon}" Data="{StaticResource IconCrosshair}"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <TextBlock Text="Прицел" Style="{StaticResource RowTitle}"/>
                                        <TextBlock x:Name="CrossDetail" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:Plate Grid.Column="2" Width="52" Height="36" Background="{StaticResource FieldBrush}" CutTopRight="7" ClipContent="True"
                                              BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                        <Canvas x:Name="CrossMini" Width="50" Height="34" RenderOptions.EdgeMode="Aliased" SnapsToDevicePixels="True"/>
                                    </ui:Plate>
                                    <Path Style="{StaticResource Chevron}"/>
                                </Grid>
                            </Button>
                        </UniformGrid>
                    </ui:Plate>

                    <!-- Last game -->
                    <ui:Plate Grid.Column="2" Style="{StaticResource SlabPad}">
                        <StackPanel>
                            <TextBlock Text="Последняя игра" Style="{StaticResource Section}" Margin="0"/>
                            <TextBlock x:Name="LastWhen" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                            <StackPanel x:Name="LastBody" Visibility="Collapsed" Margin="0,14,0,0">
                                <TextBlock x:Name="LastAvg" Style="{StaticResource BigNum}" FontSize="76" LineHeight="72" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="средний FPS" Style="{StaticResource Label}" HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <StackPanel Margin="0,0,30,0">
                                        <TextBlock x:Name="LastLow" Style="{StaticResource BigNum}" FontSize="38" LineHeight="40"/>
                                        <TextBlock Text="1% low" Style="{StaticResource ColHead}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="LastDelta" Style="{StaticResource BigNum}" FontSize="38" LineHeight="40"/>
                                        <TextBlock Text="к прошлой" Style="{StaticResource ColHead}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource LinkButton}" Content="Все замеры" Tag="sessions" Click="Open_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                        </StackPanel>
                    </ui:Plate>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
