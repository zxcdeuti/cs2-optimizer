<Window x:Class="CS2Optimizer.Views.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CS2 Optimizer" Icon="/Assets/app.ico" Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}"
        BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="OnDrag" KeyDown="OnKey">
    <StackPanel>
        <Rectangle x:Name="Strip" Height="3" Fill="{StaticResource AccentBrush}"/>
        <StackPanel Margin="26,20,26,24">
            <TextBlock x:Name="Eyebrow" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="TitleText" Style="{StaticResource Section}" FontSize="30" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" FontSize="13.5" LineHeight="20" Margin="0,8,0,0"/>

            <ItemsControl x:Name="Items" Margin="0,14,0,0" Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,7">
                            <TextBlock Text="{Binding}" FontSize="13.5"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelBtn" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="SecondaryBtn" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Secondary_Click"/>
                <Button x:Name="PrimaryBtn" Style="{StaticResource PrimaryButton}" Click="Primary_Click"/>
            </WrapPanel>
        </StackPanel>
    </StackPanel>
</Window>
