<UserControl x:Class="CS2Optimizer.Views.LaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CS2Optimizer.Views"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,0,44,44" MaxWidth="1160" HorizontalAlignment="Stretch">
            <TextBlock Text="ПАРАМЕТРЫ ЗАПУСКА" Style="{StaticResource H1}"/>
            <TextBlock Text="Отметь нужное, и строка соберётся ниже. Вставь её в Steam: Библиотека → ПКМ по CS2 → Свойства → Общие → Параметры запуска."
                       Style="{StaticResource Lead}"/>

            <!-- The result comes first: it is what this page is for -->
            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Click="OpenSteam_Click" Margin="0,0,8,0" Content="Открыть CS2 в Steam"/>
                    <Button Style="{StaticResource PrimaryButton}" Click="Copy_Click">
                        <TextBlock x:Name="CopyText" Text="Копировать строку"/>
                    </Button>
                </StackPanel>
                <TextBlock Text="Итоговая строка" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox x:Name="ResultBox" Style="{StaticResource CodeBox}"/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Сейчас в Steam" Style="{StaticResource ColHead}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                <TextBlock x:Name="CurrentText" Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </Grid>

            <TextBlock Text="Параметры" Style="{StaticResource Section}"/>
            <ui:Plate Style="{StaticResource Slab}">
                <ItemsControl x:Name="OptionList" Margin="0,0,0,-1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="190"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding IsOn}" Click="Option_Click" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                        <TextBlock Text="{Binding Option.Title}" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="{Binding Option.Hint}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Option.Flag}" Style="{StaticResource Cmd}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:Plate>

            <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" MaxWidth="660" HorizontalAlignment="Left"
                       Text="Steam хранит строку у себя и перезаписывает свой файл, поэтому приложение её только показывает, вставить нужно вручную."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
