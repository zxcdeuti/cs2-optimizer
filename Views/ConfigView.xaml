<UserControl x:Class="CS2Optimizer.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CS2Optimizer.Views"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,0,44,44" MaxWidth="1160" HorizontalAlignment="Stretch">
            <TextBlock Text="КОНФИГ AUTOEXEC" Style="{StaticResource H1}"/>
            <TextBlock Text="Отметь строки, которые нужны в конфиге, и выстави значения. Приложение пишет их отдельным блоком, твои строки в autoexec.cfg не трогаются."
                       Style="{StaticResource Lead}"/>

            <ui:Plate Style="{StaticResource Slab}">
                <StackPanel Margin="0,0,0,-1">
                    <Border Style="{StaticResource Row}" Padding="34,12,0,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Настройка" Style="{StaticResource ColHead}"/>
                            <TextBlock Grid.Column="1" Text="Значение" Style="{StaticResource ColHead}"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="Rows"/>
                </StackPanel>
            </ui:Plate>

            <DockPanel Margin="0,30,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Click="Copy_Click" Margin="0,0,8,0">
                        <TextBlock x:Name="CopyText" Text="Копировать"/>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="Save_Click" Content="Сохранить в autoexec.cfg"/>
                </StackPanel>
                <TextBlock Text="Блок конфига" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox x:Name="Preview" Style="{StaticResource CodeBox}" AcceptsReturn="True"/>
            <TextBlock x:Name="HintText" Style="{StaticResource Muted}" Margin="0,10,0,0"
                       Text="Чтобы конфиг применялся при каждом запуске, в параметрах запуска нужен +exec autoexec (раздел «Параметры запуска»)."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
