<UserControl x:Class="CS2Optimizer.Views.GraphicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,6,48,48">
            <TextBlock Text="02 / ГРАФИКА" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Пресеты графики" Style="{StaticResource H1}"/>
            <TextBlock Text="Пресет переписывает cs2_video.txt. Перед записью делается резервная копия, разрешение экрана не трогается."
                       Style="{StaticResource Lead}"/>
            <Rectangle Style="{StaticResource PageRule}"/>

            <Border x:Name="RunningBanner" Visibility="Collapsed" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1,0,0,0"
                    Background="{StaticResource WarnSoftBrush}" Padding="16,11" Margin="0,0,0,20">
                <TextBlock Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" FontSize="13"
                           Text="CS2 запущена. Закрой игру перед применением: при выходе она перезапишет файл."/>
            </Border>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="ФАЙЛ" Style="{StaticResource Label}"/>
                <TextBlock x:Name="PathText" Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="FolderBtn" Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click" Margin="0,0,8,0" Content="Открыть папку"/>
                    <Button x:Name="RollbackBtn" Style="{StaticResource SecondaryButton}" Click="Rollback_Click" Content="Откатить"/>
                </StackPanel>
            </Grid>

            <UniformGrid Columns="3" Margin="0,0,-12,0">
                <RadioButton Style="{StaticResource PresetCard}" GroupName="preset" Tag="fps" Checked="Preset_Checked" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="A — СОРЕВНОВАТЕЛЬНЫЙ" Style="{StaticResource Label}" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Максимум FPS" Style="{StaticResource H2}" FontSize="22" Margin="0,14,0,8"/>
                        <TextBlock Text="Всё на минимум, CMAA2 вместо MSAA, Reflex + Boost." Style="{StaticResource Muted}"/>
                        <TextBlock Text="ТЕНИ НИЗК · ТЕКСТ НИЗК · AO ВЫКЛ" Style="{StaticResource Label}" Margin="0,16,0,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource PresetCard}" GroupName="preset" Tag="balance" Checked="Preset_Checked" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="B — СБАЛАНСИРОВАННЫЙ" Style="{StaticResource Label}"/>
                        <TextBlock Text="Баланс" Style="{StaticResource H2}" FontSize="22" Margin="0,14,0,8"/>
                        <TextBlock Text="Средние тени и текстуры, MSAA 2x. Чище картинка, FPS высокий." Style="{StaticResource Muted}"/>
                        <TextBlock Text="ТЕНИ СРЕД · ТЕКСТ СРЕД · MSAA 2X" Style="{StaticResource Label}" Margin="0,16,0,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource PresetCard}" GroupName="preset" Tag="quality" Checked="Preset_Checked" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="C — КАРТИНКА" Style="{StaticResource Label}"/>
                        <TextBlock Text="Качество" Style="{StaticResource H2}" FontSize="22" Margin="0,14,0,8"/>
                        <TextBlock Text="Высокие тени и текстуры, MSAA 4x. Когда FPS с запасом." Style="{StaticResource Muted}"/>
                        <TextBlock Text="ТЕНИ ВЫС · ТЕКСТ ВЫС · MSAA 4X" Style="{StaticResource Label}" Margin="0,16,0,0"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <!-- Diff table -->
            <Grid Margin="0,36,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.3*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="ПАРАМЕТР" Style="{StaticResource Label}"/>
                <TextBlock Grid.Column="1" Text="СЕЙЧАС" Style="{StaticResource Label}"/>
                <TextBlock Grid.Column="2" Text="ПОСЛЕ ПРЕСЕТА" Style="{StaticResource Label}"/>
            </Grid>
            <Rectangle Style="{StaticResource Hairline}"/>
            <ItemsControl x:Name="DiffList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding Current}" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding New}" FontSize="13" FontWeight="{Binding NewWeight}" Foreground="{Binding NewBrush}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,24,0,0">
                <Button x:Name="ApplyBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Apply_Click"
                        IsEnabled="False" Content="Применить пресет"/>
                <TextBlock x:Name="ResultText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" FontSize="13"
                           Foreground="{StaticResource OkBrush}"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
