<UserControl x:Class="CS2Optimizer.Views.GraphicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CS2Optimizer.Views"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,0,44,44" MaxWidth="1160" HorizontalAlignment="Stretch">
            <TextBlock Text="ГРАФИКА" Style="{StaticResource H1}"/>
            <TextBlock Text="Пресет переписывает cs2_video.txt. Перед записью делается резервная копия, разрешение экрана не трогается."
                       Style="{StaticResource Lead}"/>

            <ui:Plate x:Name="RunningBanner" Visibility="Collapsed" Background="{StaticResource WarnSoftBrush}" CutTopRight="10" Padding="16,11" Margin="0,0,0,20">
                <TextBlock Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" FontSize="13"
                           Text="CS2 запущена. Закрой игру перед применением: при выходе она перезапишет файл."/>
            </ui:Plate>

            <UniformGrid Columns="3" Margin="0,0,-12,0">
                <RadioButton Style="{StaticResource PresetCard}" GroupName="preset" Tag="fps" Checked="Preset_Checked" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Максимум FPS" Style="{StaticResource Section}" FontSize="30" Margin="0"/>
                        <TextBlock Text="Для соревновательной игры: всё на минимум, CMAA2 вместо MSAA, Reflex + Boost." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        <TextBlock Text="Тени и текстуры низкие, AO выключен" Style="{StaticResource ColHead}" TextWrapping="Wrap" Margin="0,14,22,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource PresetCard}" GroupName="preset" Tag="balance" Checked="Preset_Checked" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Баланс" Style="{StaticResource Section}" FontSize="30" Margin="0"/>
                        <TextBlock Text="Средние тени и текстуры, MSAA 2x. Чище картинка, FPS высокий." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        <TextBlock Text="Тени и текстуры средние, MSAA 2x" Style="{StaticResource ColHead}" TextWrapping="Wrap" Margin="0,14,22,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource PresetCard}" GroupName="preset" Tag="quality" Checked="Preset_Checked" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Качество" Style="{StaticResource Section}" FontSize="30" Margin="0"/>
                        <TextBlock Text="Высокие тени и текстуры, MSAA 4x. Когда FPS с запасом." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        <TextBlock Text="Тени и текстуры высокие, MSAA 4x" Style="{StaticResource ColHead}" TextWrapping="Wrap" Margin="0,14,22,0"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <DockPanel Margin="0,20,0,0">
                <Button x:Name="ApplyBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Apply_Click"
                        IsEnabled="False" Content="Применить пресет"/>
                <TextBlock x:Name="ResultText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" FontSize="13"
                           Foreground="{StaticResource OkBrush}"/>
            </DockPanel>

            <!-- Diff table -->
            <TextBlock Text="Что изменится" Style="{StaticResource Section}"/>
            <ui:Plate Style="{StaticResource Slab}">
                <StackPanel Margin="0,0,0,-1">
                    <Border Style="{StaticResource Row}" Padding="0,12,0,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Параметр" Style="{StaticResource ColHead}"/>
                            <TextBlock Grid.Column="1" Text="Сейчас" Style="{StaticResource ColHead}"/>
                            <TextBlock Grid.Column="2" Text="После пресета" Style="{StaticResource ColHead}"/>
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="DiffList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Current}" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding New}" FontSize="13" FontWeight="{Binding NewWeight}" Foreground="{Binding NewBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Plate>

            <!-- The file itself -->
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Файл настроек" Style="{StaticResource ColHead}" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="PathText" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,3,0,0"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="FolderBtn" Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click" Margin="0,0,8,0" Content="Открыть папку"/>
                    <Button x:Name="RollbackBtn" Style="{StaticResource SecondaryButton}" Click="Rollback_Click" Content="Откатить"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
