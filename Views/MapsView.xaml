<UserControl x:Class="CS2Optimizer.Views.MapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CS2Optimizer.Views"
             Loaded="OnLoaded">
    <Grid Margin="44,0,44,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="Подписи" Style="{StaticResource ColHead}" Margin="0,0,10,6"/>
                <RadioButton x:Name="LangRu" Style="{StaticResource Chip}" GroupName="lang" Content="RU" IsChecked="True" Checked="Lang_Checked"/>
                <RadioButton x:Name="LangEn" Style="{StaticResource Chip}" GroupName="lang" Content="EN" Checked="Lang_Checked" Margin="0,0,0,6"/>
            </StackPanel>
            <TextBlock Text="КАРТЫ" Style="{StaticResource H1}"/>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,16,0,14">
            <Grid DockPanel.Dock="Right" Width="196" VerticalAlignment="Top">
                <TextBox x:Name="SearchBox" Style="{StaticResource Field}" FontSize="13" TextChanged="Search_Changed"/>
                <TextBlock x:Name="SearchHint" Text="Найти: банан, окно, long…" Style="{StaticResource Muted}"
                           IsHitTestVisible="False" Margin="13,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <WrapPanel x:Name="MapHost" VerticalAlignment="Center" Margin="0,0,16,0"/>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- Radar -->
            <ui:Plate BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CutTopRight="20" Background="{StaticResource FieldBrush}" ClipContent="True">
                <Grid>
                    <Rectangle Fill="{StaticResource GridBrush}"/>
                    <!-- Frame = the cropped square of the radar; Board = the full 1024² radar shifted inside it -->
                    <Viewbox Margin="10" Stretch="Uniform">
                        <Grid x:Name="Frame" Width="1024" Height="1024" ClipToBounds="True" Background="Transparent"
                              MouseWheel="Frame_MouseWheel" MouseLeftButtonDown="Frame_MouseDown" MouseMove="Frame_MouseMove"
                              MouseLeftButtonUp="Frame_MouseUp">
                            <Grid x:Name="Board" Width="1024" Height="1024" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Image x:Name="RadarImage" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Canvas x:Name="Marks"/>
                            </Grid>
                        </Grid>
                    </Viewbox>
                    <StackPanel x:Name="LayerHost" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" MaxWidth="360"/>
                    <TextBlock Text="Колесо: зум. Тяни: двигать. Двойной клик: сброс." FontSize="11.5" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Left"
                               VerticalAlignment="Bottom" Margin="14,0,0,10" IsHitTestVisible="False"/>
                </Grid>
            </ui:Plate>

            <!-- Side panel: selected place + list -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="MapTitle" Style="{StaticResource H1}" FontSize="44" LineHeight="46"/>
                    <TextBlock x:Name="MapSub" Style="{StaticResource ColHead}" HorizontalAlignment="Left" Margin="0,0,0,14"/>

                    <ui:Plate x:Name="InfoCard" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CutTopRight="12"
                              Padding="14,11" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="InfoEn" Style="{StaticResource Section}" Margin="0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="InfoRu" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="InfoSlang" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="InfoDesc" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ui:Plate>

                    <WrapPanel Margin="0,0,0,6">
                        <RadioButton x:Name="ModeZones" Style="{StaticResource Chip}" GroupName="mode" Content="Зоны игры" IsChecked="True" Checked="Mode_Checked"/>
                        <RadioButton x:Name="ModeBook" Style="{StaticResource Chip}" GroupName="mode" Content="Колауты игроков" Checked="Mode_Checked"/>
                    </WrapPanel>
                    <TextBlock x:Name="ListTitle" Text="Все зоны" Style="{StaticResource ColHead}" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <Rectangle Style="{StaticResource Hairline}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PlaceList"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
