<UserControl x:Class="CS2Optimizer.Views.WatermarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:CS2Optimizer.Views"
             xmlns:ui="clr-namespace:CS2Optimizer.Views"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource Num}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock" BasedOn="{StaticResource Section}">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,0,44,44" MaxWidth="1160" HorizontalAlignment="Stretch">
            <TextBlock Text="ВАТЕРМАРКА" Style="{StaticResource H1}"/>
            <TextBlock Text="Плашка поверх игры с FPS, загрузкой и температурой. Клики проходят сквозь неё. Все изменения применяются сразу, даже когда она уже на экране."
                       Style="{StaticResource Lead}"/>

            <!-- State -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource DimBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Выключена" Style="{StaticResource RowTitle}"/>
                    <TextBlock x:Name="StatusSub" Style="{StaticResource Muted}" Margin="0,1,0,0"/>
                </StackPanel>
                <Button x:Name="ToggleBtn" Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="Toggle_Click" VerticalAlignment="Center">
                    <TextBlock x:Name="ToggleText" Text="Включить"/>
                </Button>
            </Grid>

            <!-- Preview: mock game frame -->
            <ui:Plate CutTopRight="20" ClipContent="True" Height="230" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <ui:Plate.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7C93A8" Offset="0"/>
                        <GradientStop Color="#B9A27E" Offset="0.58"/>
                        <GradientStop Color="#5E4B33" Offset="1"/>
                    </LinearGradientBrush>
                </ui:Plate.Background>
                <Grid>
                    <Rectangle VerticalAlignment="Bottom" Height="88" Fill="#33000000"/>
                    <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Canvas.Left="9.5" Canvas.Top="4" Width="1" Height="4" Fill="#00FFFF"/>
                        <Rectangle Canvas.Left="9.5" Canvas.Top="12" Width="1" Height="4" Fill="#00FFFF"/>
                        <Rectangle Canvas.Left="4" Canvas.Top="9.5" Width="4" Height="1" Fill="#00FFFF"/>
                        <Rectangle Canvas.Left="12" Canvas.Top="9.5" Width="4" Height="1" Fill="#00FFFF"/>
                    </Canvas>
                    <TextBlock Text="Так плашка будет выглядеть в игре" FontSize="11.5" Foreground="#CCFFFFFF" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                    <v:WatermarkBar x:Name="Preview" Margin="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
            </ui:Plate>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Own icon -->
                    <ui:Plate Style="{StaticResource SlabPad}" AllowDrop="True" DragOver="Logo_DragOver" Drop="Logo_Drop">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <CheckBox x:Name="LogoToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Padding="0" VerticalAlignment="Center" Click="Option_Click"
                                          ToolTip="Показывать значок на плашке"/>
                                <TextBlock Text="Логотип" Style="{StaticResource Sub}" Margin="0"/>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <ui:Plate Width="72" Height="72" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                                          CutTopRight="10" Padding="9">
                                    <Image x:Name="LogoThumb" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </ui:Plate>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <WrapPanel>
                                        <Button Style="{StaticResource PrimaryButton}" Content="Выбрать картинку" Click="LogoPick_Click" Margin="0,0,8,6"/>
                                        <Button x:Name="LogoResetBtn" Style="{StaticResource SecondaryButton}" Content="Вернуть стандартный" Click="LogoReset_Click" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="LogoStatus" Style="{StaticResource Muted}" Text="PNG, JPG, BMP, ICO или WEBP. Можно просто перетащить файл сюда."/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Форма" Style="{StaticResource ColHead}" HorizontalAlignment="Left" Margin="0,16,0,7"/>
                            <WrapPanel x:Name="LogoShapeHost">
                                <RadioButton Style="{StaticResource Chip}" GroupName="logoShape" Tag="Rounded" Content="Скруглённый" Checked="Choice_Checked"/>
                                <RadioButton Style="{StaticResource Chip}" GroupName="logoShape" Tag="Circle" Content="Круг" Checked="Choice_Checked"/>
                                <RadioButton Style="{StaticResource Chip}" GroupName="logoShape" Tag="Original" Content="Как есть" Checked="Choice_Checked"/>
                            </WrapPanel>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Размер" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="LogoSizeSlider" Grid.Column="1" Minimum="14" Maximum="40" TickFrequency="2" ValueChanged="Slider_Changed"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding Value, ElementName=LogoSizeSlider, StringFormat={}{0} px}"/>
                            </Grid>
                        </StackPanel>
                    </ui:Plate>

                    <!-- Look -->
                    <ui:Plate Style="{StaticResource SlabPad}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Оформление" Style="{StaticResource Sub}" Margin="0,0,0,12"/>
                            <TextBlock Text="Стиль" Style="{StaticResource ColHead}" HorizontalAlignment="Left" Margin="0,0,0,7"/>
                            <WrapPanel x:Name="LookHost">
                                <RadioButton Style="{StaticResource Chip}" GroupName="look" Tag="Panel" Content="Плашка" Checked="Choice_Checked"/>
                                <RadioButton Style="{StaticResource Chip}" GroupName="look" Tag="Capsule" Content="Капсула" Checked="Choice_Checked"/>
                                <RadioButton Style="{StaticResource Chip}" GroupName="look" Tag="Clear" Content="Без фона" Checked="Choice_Checked"/>
                            </WrapPanel>

                            <TextBlock Text="Раскладка" Style="{StaticResource ColHead}" HorizontalAlignment="Left" Margin="0,10,0,7"/>
                            <WrapPanel x:Name="LayoutHost">
                                <RadioButton Style="{StaticResource Chip}" GroupName="layout" Tag="Row" Content="В строку" Checked="Choice_Checked"/>
                                <RadioButton Style="{StaticResource Chip}" GroupName="layout" Tag="Column" Content="Столбиком" Checked="Choice_Checked"/>
                            </WrapPanel>

                            <TextBlock Text="Цвет FPS" Style="{StaticResource ColHead}" HorizontalAlignment="Left" Margin="0,10,0,7"/>
                            <WrapPanel>
                                <Button Style="{StaticResource Swatch}" Background="#F5B335" Tag="#F5B335" Click="Accent_Click" ToolTip="Золотой"/>
                                <Button Style="{StaticResource Swatch}" Background="#D4FF3F" Tag="#D4FF3F" Click="Accent_Click" ToolTip="Лайм"/>
                                <Button Style="{StaticResource Swatch}" Background="#3CEBFF" Tag="#3CEBFF" Click="Accent_Click" ToolTip="Голубой"/>
                                <Button Style="{StaticResource Swatch}" Background="#FF8A1F" Tag="#FF8A1F" Click="Accent_Click" ToolTip="Оранжевый"/>
                                <Button Style="{StaticResource Swatch}" Background="#FF4FD8" Tag="#FF4FD8" Click="Accent_Click" ToolTip="Розовый"/>
                                <Button Style="{StaticResource Swatch}" Background="#FF5A4E" Tag="#FF5A4E" Click="Accent_Click" ToolTip="Красный"/>
                                <Button Style="{StaticResource Swatch}" Background="#F2F2F3" Tag="#F2F2F3" Click="Accent_Click" ToolTip="Белый"/>
                            </WrapPanel>

                            <TextBlock Text="Надпись" Style="{StaticResource ColHead}" HorizontalAlignment="Left" Margin="0,10,0,7"/>
                            <TextBox x:Name="TagBox" Style="{StaticResource Field}" MaxLength="20" TextChanged="Tag_Changed"/>
                            <TextBlock Text="Ник или тег рядом с логотипом. Пусто: не показывать." Style="{StaticResource Muted}" Margin="0,6,0,0"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Размер" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="70" Maximum="160" TickFrequency="10" ValueChanged="Slider_Changed"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0}%}"/>
                                <TextBlock Grid.Row="1" Text="Фон" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="OpacitySlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" ValueChanged="Slider_Changed"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0}%}"/>
                            </Grid>
                        </StackPanel>
                    </ui:Plate>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- Content -->
                    <ui:Plate Style="{StaticResource SlabPad}" Padding="22,16,22,12">
                        <StackPanel>
                            <TextBlock Text="Что показывать" Style="{StaticResource Sub}" Margin="0,0,0,6"/>
                            <CheckBox x:Name="FpsToggle" Style="{StaticResource Toggle}" Padding="0,7" Content="FPS" Click="Option_Click"/>
                            <CheckBox x:Name="CpuToggle" Style="{StaticResource Toggle}" Padding="0,7" Content="Процессор: загрузка и температура" Click="Option_Click"/>
                            <CheckBox x:Name="GpuToggle" Style="{StaticResource Toggle}" Padding="0,7" Content="Видеокарта: загрузка и температура" Click="Option_Click"/>
                            <CheckBox x:Name="LabelsToggle" Style="{StaticResource Toggle}" Padding="0,7" Content="Подписи FPS, CPU, GPU" Click="Option_Click"/>
                        </StackPanel>
                    </ui:Plate>

                    <!-- Position -->
                    <ui:Plate Style="{StaticResource SlabPad}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Положение" Style="{StaticResource Sub}" Margin="0,0,0,12"/>
                            <UniformGrid x:Name="CornerHost" Columns="2" Width="262" HorizontalAlignment="Left">
                                <RadioButton Style="{StaticResource Chip}" GroupName="corner" Tag="TopLeft" Content="↖ Слева сверху" Checked="Choice_Checked"/>
                                <RadioButton Style="{StaticResource Chip}" GroupName="corner" Tag="TopRight" Content="↗ Справа сверху" Checked="Choice_Checked"/>
                                <RadioButton Style="{StaticResource Chip}" GroupName="corner" Tag="BottomLeft" Content="↙ Слева снизу" Checked="Choice_Checked"/>
                                <RadioButton Style="{StaticResource Chip}" GroupName="corner" Tag="BottomRight" Content="↘ Справа снизу" Checked="Choice_Checked"/>
                            </UniformGrid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="От края" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="OffsetSlider" Grid.Column="1" Minimum="0" Maximum="80" TickFrequency="2" ValueChanged="Slider_Changed"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding Value, ElementName=OffsetSlider, StringFormat={}{0} px}"/>
                            </Grid>
                        </StackPanel>
                    </ui:Plate>

                    <!-- Hotkey -->
                    <ui:Plate Style="{StaticResource SlabPad}" Margin="0,20,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <CheckBox x:Name="HotkeyToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Padding="0" Click="HotkeyToggle_Click" VerticalAlignment="Center"/>
                                <TextBlock Text="Бинд" Style="{StaticResource Sub}" Margin="0"/>
                            </DockPanel>
                            <Button x:Name="HotkeyBtn" Style="{StaticResource SecondaryButton}" MinWidth="130" HorizontalAlignment="Left"
                                    Click="Hotkey_Click" PreviewKeyDown="Hotkey_KeyDown" LostKeyboardFocus="Hotkey_LostFocus"
                                    ToolTip="Нажми и введи новое сочетание. Esc: отмена.">
                                <TextBlock x:Name="HotkeyText" FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                            </Button>
                            <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Muted}" Margin="0,9,0,0"/>
                        </StackPanel>
                    </ui:Plate>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,16,0,0"
                               Text="FPS считается через системный трейсинг DirectX, для этого Windows спросит права администратора. Поверх CS2 плашка видна в режиме «Окно без рамки». Температура CPU берётся с датчика платы рядом с процессором, она примерная."/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
