<UserControl x:Class="CS2Optimizer.Views.WatermarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:CS2Optimizer.Views"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource Num}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,6,48,48">
            <TextBlock Text="09 / ВАТЕРМАРКА" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Ватермарка в игре" Style="{StaticResource H1}"/>
            <TextBlock Text="Плашка поверх игры с FPS, загрузкой и температурой. Клики проходят сквозь неё. Все изменения применяются сразу, даже когда она уже на экране."
                       Style="{StaticResource Lead}"/>
            <Rectangle Style="{StaticResource PageRule}"/>

            <!-- Status bar -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock x:Name="StatusText" Text="ВЫКЛЮЧЕНА" Style="{StaticResource Label}" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                    <TextBlock x:Name="StatusSub" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="ToggleBtn" Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="Toggle_Click">
                    <TextBlock x:Name="ToggleText" Text="Включить"/>
                </Button>
            </Grid>

            <!-- Hotkey -->
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Padding="0,14" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="БИНД" Style="{StaticResource Label}" Margin="0,0,16,0"/>
                    <Button x:Name="HotkeyBtn" Grid.Column="1" Style="{StaticResource SecondaryButton}" MinWidth="130"
                            Click="Hotkey_Click" PreviewKeyDown="Hotkey_KeyDown" LostKeyboardFocus="Hotkey_LostFocus"
                            ToolTip="Нажми и введи новое сочетание. Esc — отмена.">
                        <TextBlock x:Name="HotkeyText" FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                    </Button>
                    <TextBlock x:Name="HotkeyStatus" Grid.Column="2" Style="{StaticResource Muted}" Margin="16,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="HotkeyToggle" Grid.Column="3" Style="{StaticResource Toggle}" Padding="0" Click="HotkeyToggle_Click"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Preview: mock game frame -->
            <Border CornerRadius="4" ClipToBounds="True" Height="260" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7C93A8" Offset="0"/>
                        <GradientStop Color="#B9A27E" Offset="0.58"/>
                        <GradientStop Color="#5E4B33" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Rectangle VerticalAlignment="Bottom" Height="100" Fill="#33000000"/>
                    <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Canvas.Left="9.5" Canvas.Top="4" Width="1" Height="4" Fill="#00FFFF"/>
                        <Rectangle Canvas.Left="9.5" Canvas.Top="12" Width="1" Height="4" Fill="#00FFFF"/>
                        <Rectangle Canvas.Left="4" Canvas.Top="9.5" Width="4" Height="1" Fill="#00FFFF"/>
                        <Rectangle Canvas.Left="12" Canvas.Top="9.5" Width="4" Height="1" Fill="#00FFFF"/>
                    </Canvas>
                    <TextBlock Text="ПРЕВЬЮ" Style="{StaticResource Label}" Foreground="#99FFFFFF" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                    <v:WatermarkBar x:Name="Preview" Margin="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Grid Margin="0,32,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Look -->
                <StackPanel>
                    <TextBlock Text="СТИЛЬ" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                    <WrapPanel x:Name="LookHost">
                        <RadioButton Style="{StaticResource Chip}" GroupName="look" Tag="Panel" Content="Плашка" Checked="Choice_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="look" Tag="Capsule" Content="Капсула" Checked="Choice_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="look" Tag="Clear" Content="Без фона" Checked="Choice_Checked"/>
                    </WrapPanel>

                    <TextBlock Text="РАСКЛАДКА" Style="{StaticResource Label}" Margin="0,16,0,10"/>
                    <WrapPanel x:Name="LayoutHost">
                        <RadioButton Style="{StaticResource Chip}" GroupName="layout" Tag="Row" Content="В строку" Checked="Choice_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="layout" Tag="Column" Content="Столбиком" Checked="Choice_Checked"/>
                    </WrapPanel>

                    <TextBlock Text="АКЦЕНТ" Style="{StaticResource Label}" Margin="0,16,0,10"/>
                    <WrapPanel>
                        <Button Style="{StaticResource Swatch}" Background="#D4FF3F" Tag="#D4FF3F" Click="Accent_Click" ToolTip="Лайм"/>
                        <Button Style="{StaticResource Swatch}" Background="#3CEBFF" Tag="#3CEBFF" Click="Accent_Click" ToolTip="Голубой"/>
                        <Button Style="{StaticResource Swatch}" Background="#FF8A1F" Tag="#FF8A1F" Click="Accent_Click" ToolTip="Оранжевый"/>
                        <Button Style="{StaticResource Swatch}" Background="#FF4FD8" Tag="#FF4FD8" Click="Accent_Click" ToolTip="Розовый"/>
                        <Button Style="{StaticResource Swatch}" Background="#FF5A4E" Tag="#FF5A4E" Click="Accent_Click" ToolTip="Красный"/>
                        <Button Style="{StaticResource Swatch}" Background="#F2F2F3" Tag="#F2F2F3" Click="Accent_Click" ToolTip="Белый"/>
                    </WrapPanel>

                    <TextBlock Text="НАДПИСЬ" Style="{StaticResource Label}" Margin="0,16,0,10"/>
                    <TextBox x:Name="TagBox" Style="{StaticResource Field}" MaxLength="20" TextChanged="Tag_Changed"/>
                    <TextBlock Text="Ник или тег рядом с логотипом. Пусто — не показывать." Style="{StaticResource Muted}" Margin="0,6,0,0"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Размер" Style="{StaticResource RowLabel}"/>
                        <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="70" Maximum="160" TickFrequency="10" ValueChanged="Slider_Changed"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0}%}"/>
                        <TextBlock Grid.Row="1" Text="Непрозрачность фона" Style="{StaticResource RowLabel}" TextWrapping="Wrap"/>
                        <Slider x:Name="OpacitySlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" ValueChanged="Slider_Changed"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0}%}"/>
                    </Grid>
                </StackPanel>

                <!-- Content & position -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ПОКАЗЫВАТЬ" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <Rectangle Style="{StaticResource Hairline}"/>
                    <CheckBox x:Name="FpsToggle" Style="{StaticResource Toggle}" Content="FPS" Click="Option_Click"/>
                    <CheckBox x:Name="CpuToggle" Style="{StaticResource Toggle}" Content="Процессор — загрузка и температура" Click="Option_Click"/>
                    <CheckBox x:Name="GpuToggle" Style="{StaticResource Toggle}" Content="Видеокарта — загрузка и температура" Click="Option_Click"/>
                    <CheckBox x:Name="LogoToggle" Style="{StaticResource Toggle}" Content="Логотип" Click="Option_Click"/>
                    <CheckBox x:Name="LabelsToggle" Style="{StaticResource Toggle}" Content="Подписи FPS / CPU / GPU" Click="Option_Click"/>

                    <TextBlock Text="ПОЛОЖЕНИЕ" Style="{StaticResource Label}" Margin="0,22,0,10"/>
                    <UniformGrid x:Name="CornerHost" Columns="2" Width="240" HorizontalAlignment="Left">
                        <RadioButton Style="{StaticResource Chip}" GroupName="corner" Tag="TopLeft" Content="↖ Слева сверху" Checked="Choice_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="corner" Tag="TopRight" Content="↗ Справа сверху" Checked="Choice_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="corner" Tag="BottomLeft" Content="↙ Слева снизу" Checked="Choice_Checked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="corner" Tag="BottomRight" Content="↘ Справа снизу" Checked="Choice_Checked"/>
                    </UniformGrid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Отступ от края" Style="{StaticResource RowLabel}"/>
                        <Slider x:Name="OffsetSlider" Grid.Column="1" Minimum="0" Maximum="80" TickFrequency="2" ValueChanged="Slider_Changed"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" Text="{Binding Value, ElementName=OffsetSlider, StringFormat={}{0} px}"/>
                    </Grid>

                    <TextBlock Text="ВАЖНО" Style="{StaticResource Label}" Margin="0,24,0,4"/>
                    <Rectangle Style="{StaticResource Hairline}" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="FPS считается через системный трейсинг DirectX — для этого Windows один раз спросит права администратора. Поверх CS2 плашка видна в режиме «Окно без рамки». Температура CPU — с датчика платы рядом с процессором, она примерная."/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
